---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../data/types';
import { getContent, otherLocale } from '../data';
import { GA_ID, SITE_URL } from '../data/config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page in the other language, for hreflang and the switcher */
  altPath: string;
  /** Path of this page in this language */
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { locale, title, description, altPath, path, ogImage = '/og.png', ogType = 'website', jsonLd } = Astro.props;
const t = getContent(locale);
const other = otherLocale(locale);
const canonical = `${SITE_URL}${path}`;
const ogLocale = locale === 'es' ? 'es_AR' : 'en_US';
---

<!doctype html>
<html lang={locale === 'es' ? 'es-AR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'es' ? 'es' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={other === 'es' ? 'es' : 'en'} href={`${SITE_URL}${altPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/es`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Upright:wght@300;400;500;600;700&family=Doto:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0e1522" />
    <meta name="author" content="Fabrizio Turdo" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Fabrizio Turdo · Software & Web Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${ogImage}`} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      GA_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA_ID, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header locale={locale} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      // Cada página nueva arranca arriba de todo (salvo que el link traiga #ancla).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) window.scrollTo(0, 0);
    </script>
    <script>
      if (!location.hash) {
        window.addEventListener('load', () => window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior }));
      }
      const targets = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
