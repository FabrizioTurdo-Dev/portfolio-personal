---
import { Image } from 'astro:assets';
import type { CaseStudy, Locale } from '../data/types';
import { casePath, getContent } from '../data';
import { caseImage } from './images';
import Icons from './Icons.astro';

interface Props {
  item: CaseStudy;
  locale: Locale;
  featured?: boolean;
}
const { item, locale, featured = false } = Astro.props;
const t = getContent(locale);
const cover = caseImage(item.slug, item.cover);
const href = casePath(locale, item.slug);
---

<article class:list={['case-card reveal', { featured }]}>
  <a class="case-cover" href={href} aria-label={item.name}>
    {
      cover ? (
        <Image src={cover} alt={`${item.name}: ${item.oneLiner}`} widths={[480, 800, 1200]} sizes={featured ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'} loading="lazy" />
      ) : (
        <div class="case-placeholder" aria-hidden="true">
          <span>{item.name}</span>
        </div>
      )
    }
  </a>
  <div class="case-body">
    <p class="case-kind">{item.kind}</p>
    <h3><a href={href}>{item.name}</a></h3>
    <p class="case-line">{item.oneLiner}</p>
    <a class="case-link" href={href}>{t.work.readCase} <Icons name="arrow" /></a>
  </div>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .case-cover {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper-2);
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .case-cover:hover {
    transform: translateY(-3px);
    box-shadow: 0 1px 2px rgb(23 21 15 / 0.05), 0 24px 40px -20px rgb(23 21 15 / 0.35);
  }
  .case-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .case-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: -0.03em;
    color: var(--line-strong);
    background: repeating-linear-gradient(135deg, var(--paper-2) 0 12px, var(--paper-3) 12px 13px);
  }
  .case-kind {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  .case-body h3 a {
    text-decoration: none;
  }
  .case-body h3 a:hover {
    color: var(--accent-ink);
  }
  .case-line {
    color: var(--ink-2);
    margin-top: 0.4rem;
    text-wrap: pretty;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--accent-ink);
  }
  .case-link :global(svg) {
    width: 1em;
    height: 1em;
    transition: transform 0.25s var(--ease);
  }
  .case-link:hover :global(svg) {
    transform: translateX(3px);
  }
  .featured .case-cover {
    aspect-ratio: 16 / 9;
  }
</style>
