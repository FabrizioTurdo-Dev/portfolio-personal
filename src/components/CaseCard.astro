---
import { Image } from 'astro:assets';
import type { CaseStudy, Locale } from '../data/types';
import { casePath, getContent } from '../data';
import { caseImage } from './images';
import Icons from './Icons.astro';

interface Props {
  item: CaseStudy;
  locale: Locale;
}
const { item, locale } = Astro.props;
const t = getContent(locale);
const cover = caseImage(item.slug, item.cover);
const href = casePath(locale, item.slug);
---

<article class="case-card reveal">
  <a class="case-cover" href={href} aria-label={item.name} tabindex="-1">
    {
      cover ? (
        <Image src={cover} alt={`${item.name}: ${item.oneLiner}`} widths={[320, 640, 960]} sizes="(min-width: 1000px) 33vw, (min-width: 760px) 50vw, 120px" loading="lazy" />
      ) : (
        <div class="case-placeholder" aria-hidden="true">{item.name}</div>
      )
    }
  </a>
  <div class="case-body">
    <p class="case-kind">{item.kind}</p>
    <h3><a href={href}>{item.name}</a></h3>
    <p class="case-line">{item.oneLiner}</p>
    <a class="case-link" href={href}>{t.work.readCase} <Icons name="arrow" /></a>
  </div>
</article>

<style>
  .case-card {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .case-cover {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .case-card:hover .case-cover {
    transform: translateY(-3px);
    border-color: rgb(232 179 90 / 0.5);
    box-shadow: 0 0 36px -12px var(--glow), var(--shadow);
  }
  .case-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .case-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-style: italic;
    color: var(--muted);
  }
  .case-kind {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .case-body h3 {
    font-size: 1.55rem;
  }
  .case-body h3 a {
    text-decoration: none;
  }
  .case-body h3 a:hover {
    color: var(--accent-2);
  }
  .case-line {
    color: var(--ink-2);
    margin-top: 0.35rem;
    font-size: 0.95rem;
    text-wrap: pretty;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.6rem;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--accent);
  }
  .case-link :global(svg) {
    width: 1em;
    height: 1em;
    transition: transform 0.25s var(--ease);
  }
  .case-link:hover :global(svg) {
    transform: translateX(3px);
  }
  /* Celular: fila compacta con miniatura */
  @media (max-width: 759px) {
    .case-card {
      grid-template-columns: 112px 1fr;
      gap: 0.9rem;
      align-items: start;
    }
    .case-cover {
      aspect-ratio: 4 / 3;
      border-radius: 8px;
    }
    .case-body h3 {
      font-size: 1.3rem;
    }
    .case-line {
      display: none;
    }
    .case-link {
      margin-top: 0.3rem;
    }
  }
</style>
