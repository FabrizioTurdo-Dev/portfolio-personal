---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  kind: 'phone' | 'desktop';
}
const { image, alt, kind } = Astro.props;
---

<figure class:list={['shot', `shot--${kind}`]}>
  <div class="shot-frame">
    {kind === 'desktop' && (
      <div class="shot-bar" aria-hidden="true"><span></span><span></span><span></span></div>
    )}
    <Image src={image} alt={alt} widths={kind === 'phone' ? [400, 800] : [720, 1200, 1600]} sizes={kind === 'phone' ? '(min-width: 760px) 320px, 80vw' : '(min-width: 1000px) 1000px, 100vw'} loading="lazy" />
  </div>
  <figcaption>{alt}</figcaption>
</figure>

<style>
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .shot-frame {
    background: var(--ink);
    border-radius: 16px;
    padding: 6px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .shot--desktop .shot-frame {
    padding: 0;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .shot-bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }
  .shot-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .shot--phone .shot-frame :global(img) {
    border-radius: 12px;
  }
  .shot--phone {
    max-width: 320px;
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
