---
import Base from '../layouts/Base.astro';
import type { CaseStudy, Locale } from '../data/types';
import { casePath, getContent, homePath, otherLocale } from '../data';
import { caseImage } from './images';
import { SITE_URL, whatsappUrl } from '../data/config';
import { Image } from 'astro:assets';
import CaseCard from './CaseCard.astro';
import Icons from './Icons.astro';

interface Props {
  locale: Locale;
  item: CaseStudy;
}
const { locale, item } = Astro.props;
const t = getContent(locale);
const other = otherLocale(locale);
const home = homePath(locale);
const cover = caseImage(item.slug, item.cover);
const others = t.cases.filter((c) => c.slug !== item.slug).slice(0, 3);
// Títulos largos sin la marca al final, para que Google no los corte a la mitad.
const title = item.title.length > 62 ? item.title : `${item.title} · Fabrizio Turdo`;
const ogImage = item.cover ? `/og/${item.slug}.png` : '/og.png';
const url = `${SITE_URL}${casePath(locale, item.slug)}`;
const description =
  locale === 'es'
    ? `${item.oneLiner} Caso de estudio: ${item.name}, ${item.kind}.`
    : `${item.oneLiner} Case study: ${item.name}, ${item.kind}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      '@id': `${url}#work`,
      name: item.title,
      headline: item.title,
      description: item.oneLiner,
      inLanguage: locale === 'es' ? 'es-AR' : 'en',
      image: `${SITE_URL}${ogImage}`,
      url,
      author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Fabrizio Turdo', url: `${SITE_URL}${home}` },
      about: item.name,
      keywords: item.stack,
      ...(item.links[0] ? { sameAs: item.links[0].url } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Fabrizio Turdo', item: `${SITE_URL}${home}` },
        { '@type': 'ListItem', position: 2, name: item.name, item: url },
      ],
    },
  ],
};
---

<Base locale={locale} title={title} description={description} path={casePath(locale, item.slug)} altPath={casePath(other, item.slug)} ogType="article" ogImage={ogImage} jsonLd={jsonLd}>
  <article class="case">
    <header class="case-hero">
      <div class="container">
        <a class="back" href={`${home}#trabajos`}><Icons name="arrow" /> {t.caseUi.back}</a>
        <p class="eyebrow">{item.kind}</p>
        <h1>{item.title}</h1>
        <p class="case-lede">{item.oneLiner}</p>
        {item.links.length > 0 && (
          <div class="case-links">
            {item.links.map((l, i) => (
              <a class:list={['btn', { 'btn--accent': i === 0 }]} href={l.url} target="_blank" rel="noopener">{l.label} <Icons name="external" /></a>
            ))}
          </div>
        )}
        {cover && (
          <a class="case-cover" href={item.links[0]?.url} target="_blank" rel="noopener" aria-label={item.links[0] ? `${t.caseUi.links}: ${item.links[0].label}` : item.name}>
            <span class="case-cover-bar" aria-hidden="true"><span></span><span></span><span></span></span>
            <Image src={cover} alt={`${item.name}: ${item.oneLiner}`} widths={[640, 1000, 1400]} sizes="(min-width: 1140px) 1100px, 100vw" loading="eager" />
          </a>
        )}
      </div>
    </header>

    <div class="container case-grid">
      <div class="case-main">
        <section class="case-block">
          <h2>{t.caseUi.problem}</h2>
          {item.problem.map((p) => <p>{p}</p>)}
        </section>
        <section class="case-block">
          <h2>{t.caseUi.built}</h2>
          <ul class="built">
            {item.built.map((b) => <li>{b}</li>)}
          </ul>
        </section>
        {item.result.length > 0 && (
          <section class="case-block result">
            <h2>{t.caseUi.result}</h2>
            {item.result.map((p) => <p>{p}</p>)}
          </section>
        )}
        {item.testimonial && (
          <section class="case-block">
            <h2>{t.caseUi.testimonial}</h2>
            <blockquote class="case-quote">
              <p>“{item.testimonial.quote}”</p>
              <footer>— {item.testimonial.author}</footer>
            </blockquote>
          </section>
        )}
        {item.links.length > 0 && (
          <section class="case-block live">
            <h2>{t.caseUi.links}</h2>
            <div class="case-links">
              {item.links.map((l, i) => (
                <a class:list={['btn', { 'btn--accent': i === 0 }]} href={l.url} target="_blank" rel="noopener">{l.label} <Icons name="external" /></a>
              ))}
            </div>
          </section>
        )}
      </div>
      <aside class="case-aside">
        <dl class="meta card">
          <div>
            <dt>{t.caseUi.stack}</dt>
            <dd>{item.stack}</dd>
          </div>
          <div>
            <dt>{t.caseUi.timeline}</dt>
            <dd>{item.timeline}</dd>
          </div>
          {item.links.length > 0 && (
            <div>
              <dt>{t.caseUi.links}</dt>
              <dd>
                <ul class="meta-links">
                  {item.links.map((l) => (
                    <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
        <div class="case-cta card">
          <h3>{t.caseUi.cta}</h3>
          <a class="btn btn--wa" href={whatsappUrl(t.contact.whatsapp.message)} target="_blank" rel="noopener"><Icons name="whatsapp" /> {t.caseUi.ctaButton}</a>
          <a class="small-link" href={`${home}#contacto`}>{t.nav.contact} →</a>
        </div>
      </aside>
    </div>

    <section class="section container more">
      <h2>{t.caseUi.more}</h2>
      <div class="more-grid">
        {others.map((c) => <CaseCard item={c} locale={locale} />)}
      </div>
    </section>
  </article>
</Base>

<style>
  .case-hero {
    padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .case-hero::before {
    content: '';
    position: absolute;
    left: -10vw;
    top: -20vw;
    width: 50vw;
    height: 50vw;
    max-width: 700px;
    max-height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(232 179 90 / 0.16), transparent 65%);
    filter: blur(60px);
    pointer-events: none;
  }
  .case-hero .container {
    position: relative;
  }
  .case-hero h1 {
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    max-width: 24ch;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .back :global(svg) {
    width: 1em;
    height: 1em;
    transform: rotate(180deg);
  }
  .back:hover {
    color: var(--accent-2);
  }
  .case-lede {
    font-size: 1.12rem;
    color: var(--ink-2);
    margin-top: 1rem;
    max-width: 40rem;
    text-wrap: pretty;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .case-cover {
    display: block;
    margin-top: 1.75rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: 0 0 60px -20px var(--glow), var(--shadow);
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .case-cover:hover {
    transform: translateY(-2px);
    border-color: rgb(232 179 90 / 0.5);
  }
  .case-cover-bar {
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  .case-cover-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .case-cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .case-grid {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2rem, 4.5vw, 3.5rem);
    align-items: start;
  }
  .case-block + .case-block {
    margin-top: 2.5rem;
  }
  .case-block h2 {
    font-size: 1.5rem;
    margin-bottom: 0.9rem;
  }
  .case-block p {
    color: var(--ink-2);
    max-width: 42rem;
    text-wrap: pretty;
    font-size: 0.98rem;
  }
  .built {
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .built li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-2);
    max-width: 42rem;
    font-size: 0.98rem;
  }
  .built li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.7rem;
    height: 1px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--glow);
  }
  .result p {
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .live .case-links {
    margin-top: 0;
  }
  .case-quote {
    margin: 0;
    padding: 1.1rem 1.3rem;
    border-left: 2px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-family: var(--display);
    font-size: 1.1rem;
  }
  .case-quote footer {
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .meta {
    margin: 0;
    display: grid;
    gap: 1rem;
    font-size: 0.94rem;
  }
  .meta dt {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .meta dd {
    margin: 0;
    color: var(--ink);
  }
  .meta-links {
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }
  .case-cta {
    margin-top: 1rem;
    display: grid;
    gap: 0.9rem;
    background: linear-gradient(160deg, rgb(47 179 109 / 0.1), transparent 60%), var(--surface);
  }
  .case-cta h3 {
    font-size: 1.25rem;
  }
  .small-link {
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .more {
    border-top: 1px solid var(--line);
  }
  .more h2 {
    margin-bottom: 1.5rem;
  }
  .more-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (max-width: 759px) {
    .more-grid > :global(* + *) {
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }
    .case-links .btn {
      width: 100%;
    }
    .case-aside .meta {
      display: none;
    }
  }
  @media (min-width: 760px) {
    .more-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .case-grid {
      grid-template-columns: 1fr 290px;
      gap: 4rem;
    }
    .case-aside {
      position: sticky;
      top: 92px;
    }
  }
</style>
