---
import { Image } from 'astro:assets';
import type { Locale } from '../../data/types';
import { casePath, findCase, getContent } from '../../data';
import { caseImage } from '../images';
import Icons from '../Icons.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const cs = findCase(locale, 'de-la-casa');
const cover = cs ? caseImage(cs.slug, cs.cover) : undefined;
---

<section class="section product-section" id="producto" aria-labelledby="producto-title">
  <div class="container">
    <div class="product card product-grid">
      <div class="product-copy">
        <p class="eyebrow">04 · {t.product.eyebrow}</p>
        <h2 id="producto-title">{t.product.title}</h2>
        <p class="product-name"><em class="lit">{t.product.name}</em></p>
        <p class="product-tagline">{t.product.tagline}</p>
        {t.product.text.map((p) => <p class="product-text">{p}</p>)}
        <p class="product-why">
          <strong>{t.product.whyLabel}.</strong> {t.product.why}
        </p>
        <div class="product-actions">
          <a class="btn btn--accent" href={t.product.primaryUrl} target="_blank" rel="noopener">{t.product.primary} <Icons name="external" /></a>
          {cs && <a class="btn btn--ghost" href={casePath(locale, cs.slug)}>{t.product.secondary} <Icons name="arrow" /></a>}
        </div>
      </div>
      <div class="product-visual reveal">
        {
          cover ? (
            <Image src={cover} alt={cs?.oneLiner ?? 'De la Casa'} widths={[480, 800, 1100]} sizes="(min-width: 900px) 45vw, 100vw" loading="lazy" />
          ) : (
            <div class="product-placeholder" aria-hidden="true">De la Casa</div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .product {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    background: linear-gradient(160deg, rgb(232 179 90 / 0.1), transparent 55%), var(--surface);
    border-color: rgb(232 179 90 / 0.25);
  }
  .product::after {
    content: '';
    position: absolute;
    width: 380px;
    height: 380px;
    right: -120px;
    top: -140px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow), transparent 65%);
    filter: blur(40px);
    pointer-events: none;
  }
  .product-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .product-name {
    font-family: var(--display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1;
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .product-tagline {
    color: var(--ink);
    font-size: 1.08rem;
    margin-bottom: 1rem;
  }
  .product-text {
    color: var(--ink-2);
    font-size: 0.97rem;
    text-wrap: pretty;
  }
  .product-why {
    margin-top: 1rem;
    padding: 0.9rem 1.1rem;
    border-left: 2px solid var(--accent);
    background: rgb(255 255 255 / 0.03);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .product-visual {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--bg-2);
    aspect-ratio: 4 / 3;
    box-shadow: 0 0 50px -18px var(--glow);
  }
  .product-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .product-placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-style: italic;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .product-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
    }
  }
  @media (max-width: 759px) {
    .product-text:not(:first-of-type),
    .product-visual {
      display: none;
    }
    .product-actions .btn {
      width: 100%;
    }
  }
</style>
