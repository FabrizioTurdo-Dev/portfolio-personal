---
import { Image } from 'astro:assets';
import type { Locale } from '../../data/types';
import { getContent } from '../../data';
import { CONTACT, whatsappUrl } from '../../data/config';
import Icons from '../Icons.astro';
import photo from '../../assets/fabrizio.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const ctaHref = CONTACT.calendarUrl || whatsappUrl(t.contact.calendar.fallbackMessage);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">
        {t.hero.title}
        <em>{t.hero.titleAccent}</em>
      </h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <a class="btn btn--accent" href={ctaHref} target={CONTACT.calendarUrl ? '_blank' : undefined} rel="noopener">
          <Icons name="calendar" />
          {t.hero.primary}
        </a>
        <a class="btn btn--ghost" href="#trabajos">{t.hero.secondary} <Icons name="arrow" /></a>
      </div>
      <ul class="hero-proof">
        {t.hero.proof.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
    <div class="hero-photo only-desktop">
      <div class="photo-frame">
        <Image src={photo} alt={t.about.photoAlt} width={440} widths={[360, 440, 720]} sizes="(min-width: 900px) 360px, 0px" loading="eager" fetchpriority="high" />
      </div>
      <p class="photo-caption"><span class="dot" aria-hidden="true"></span>Buenos Aires · UTC−3</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2.5rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  /* Luces de fondo */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
  }
  .hero::before {
    width: 46vw;
    height: 46vw;
    max-width: 640px;
    max-height: 640px;
    left: -12vw;
    top: -18vw;
    background: radial-gradient(circle, rgb(232 179 90 / 0.22), transparent 65%);
  }
  .hero::after {
    width: 36vw;
    height: 36vw;
    max-width: 520px;
    max-height: 520px;
    right: -10vw;
    bottom: -14vw;
    background: radial-gradient(circle, rgb(111 211 193 / 0.12), transparent 65%);
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
    position: relative;
  }
  .hero h1 em {
    display: block;
  }
  .hero-sub {
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    color: var(--ink-2);
    margin-top: 1.25rem;
    max-width: 34rem;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }
  .hero-proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1.5rem;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .hero-proof li::before {
    content: '+ ';
    color: var(--accent);
  }
  .hero-photo {
    justify-self: end;
    width: min(100%, 360px);
  }
  .photo-frame {
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 0 0 1px rgb(232 179 90 / 0.15), 0 30px 60px -30px rgb(0 0 0 / 0.8), 0 0 60px -20px var(--glow);
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }
  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
  }
  .photo-caption {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--wa);
    box-shadow: 0 0 10px 1px rgb(47 179 109 / 0.6);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
      gap: 4rem;
    }
  }
  @media (max-width: 759px) {
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
