---
import { Image } from 'astro:assets';
import type { Locale } from '../../data/types';
import { getContent } from '../../data';
import { CONTACT, whatsappUrl } from '../../data/config';
import Icons from '../Icons.astro';
import photo from '../../assets/fabrizio.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const ctaHref = CONTACT.calendarUrl || whatsappUrl(t.contact.calendar.fallbackMessage);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">
        {t.hero.title}
        <span class="accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <a class="btn btn--accent" href={ctaHref} target={CONTACT.calendarUrl ? '_blank' : undefined} rel="noopener">
          <Icons name="calendar" />
          {t.hero.primary}
        </a>
        <a class="btn btn--ghost" href="#trabajos">{t.hero.secondary} <Icons name="arrow" /></a>
      </div>
      <ul class="hero-proof">
        {t.hero.proof.map((p) => (
          <li><Icons name="check" />{p}</li>
        ))}
      </ul>
    </div>
    <div class="hero-photo">
      <div class="photo-frame">
        <Image src={photo} alt={t.about.photoAlt} width={520} widths={[360, 520, 760]} sizes="(min-width: 900px) 420px, 70vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="photo-badge">
        <span class="dot" aria-hidden="true"></span>
        Buenos Aires · UTC−3
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5.5rem);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 85% 20%, rgb(199 70 28 / 0.08), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgb(199 70 28 / 0.06), transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    position: relative;
  }
  .hero h1 .accent {
    display: block;
    color: var(--accent);
  }
  .hero-sub {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--ink-2);
    margin-top: 1.5rem;
    max-width: 36rem;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .hero-proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .hero-proof :global(svg) {
    width: 1.1em;
    height: 1.1em;
    color: var(--accent);
    flex: none;
  }
  .hero-photo {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
  }
  .photo-frame {
    border-radius: 28px;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 5;
    transform: rotate(-1.5deg);
  }
  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-badge {
    position: absolute;
    left: 50%;
    bottom: -1rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow);
    white-space: nowrap;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--wa);
    box-shadow: 0 0 0 4px var(--wa-soft);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
    }
    .hero-photo {
      justify-self: end;
    }
  }
  @media (max-width: 899px) {
    .hero-photo {
      order: -1;
      width: min(100%, 260px);
      margin-bottom: 0.5rem;
    }
    .photo-badge {
      font-size: 0.78rem;
    }
  }
</style>
