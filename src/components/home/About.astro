---
import { Image } from 'astro:assets';
import type { Locale } from '../../data/types';
import { getContent } from '../../data';
import photo from '../../assets/fabrizio.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
---

<section class="section" id="sobre-mi" aria-labelledby="sobre-title">
  <div class="container about-grid">
    <div class="about-photo reveal only-desktop">
      <Image src={photo} alt={t.about.photoAlt} width={300} widths={[300, 600]} sizes="(min-width: 900px) 260px, 0px" loading="lazy" />
    </div>
    <div class="about-copy">
      <p class="eyebrow">06 · {t.nav.about}</p>
      <h2 id="sobre-title">{t.about.title}</h2>
      <div class="about-text">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .about-photo {
    width: min(100%, 260px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }
  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
  }
  .about-text {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.9rem;
    max-width: 42rem;
    color: var(--ink-2);
    text-wrap: pretty;
    font-size: 0.98rem;
  }
  .about-text p:first-child {
    color: var(--ink);
  }
  @media (min-width: 760px) {
    .about-text p:first-child {
      font-family: var(--display);
      font-size: 1.3rem;
      line-height: 1.4;
    }
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 260px 1fr;
      gap: 4rem;
    }
    .about-photo {
      position: sticky;
      top: 96px;
    }
  }
</style>
