---
import type { Locale } from '../../data/types';
import { getContent } from '../../data';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const [first, ...rest] = t.about.paragraphs;
---

<section class="section about" id="sobre-mi" aria-labelledby="sobre-title">
  <div class="container about-grid">
    <div class="about-head">
      <p class="eyebrow">01 · {t.nav.about}</p>
      <h2 id="sobre-title">{t.about.title}</h2>
    </div>
    <div class="about-text">
      <p class="about-first">{first}</p>
      {rest.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }
  .about-text {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
    color: var(--ink-2);
    text-wrap: pretty;
    font-size: 0.98rem;
  }
  .about-first {
    color: var(--ink);
  }
  @media (min-width: 760px) {
    .about-first {
      font-family: var(--display);
      font-size: 1.35rem;
      line-height: 1.4;
    }
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
    }
  }
</style>
