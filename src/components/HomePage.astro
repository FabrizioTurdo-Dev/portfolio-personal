---
import Base from '../layouts/Base.astro';
import type { Locale } from '../data/types';
import { getContent, homePath, otherLocale } from '../data';
import { SITE_URL, CONTACT } from '../data/config';
import Hero from './home/Hero.astro';
import Services from './home/Services.astro';
import Work from './home/Work.astro';
import Process from './home/Process.astro';
import Product from './home/Product.astro';
import About from './home/About.astro';
import Testimonials from './home/Testimonials.astro';
import Faq from './home/Faq.astro';
import Contact from './home/Contact.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#studio`,
      name: 'Fabrizio Turdo · Software & Web Studio',
      url: SITE_URL,
      email: CONTACT.email,
      telephone: `+${CONTACT.whatsapp}`,
      description: t.meta.description,
      areaServed: ['AR', 'US', 'GB', 'ES'],
      address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
      founder: { '@id': `${SITE_URL}/#person` },
      priceRange: 'USD 1000+',
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'Fabrizio Turdo',
      jobTitle: locale === 'es' ? 'Desarrollador de software' : 'Software developer',
      url: SITE_URL,
      sameAs: [CONTACT.github],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} path={homePath(locale)} altPath={homePath(otherLocale(locale))} jsonLd={jsonLd}>
  <Hero locale={locale} />
  <About locale={locale} />
  <Services locale={locale} />
  <Work locale={locale} />
  <Process locale={locale} />
  <Product locale={locale} />
  <Testimonials locale={locale} />
  <Faq locale={locale} />
  <Contact locale={locale} />
</Base>
