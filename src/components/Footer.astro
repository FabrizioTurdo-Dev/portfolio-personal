---
import type { Locale } from '../data/types';
import { getContent, homePath } from '../data';
import { CONTACT, whatsappUrl } from '../data/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const home = homePath(locale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-name">Fabrizio Turdo</span>
      <span class="muted">{t.footer.line}</span>
    </div>
    <ul class="footer-links">
      <li><a href={`${home}#trabajos`}>{t.nav.work}</a></li>
      <li><a href={`${home}#servicios`}>{t.nav.services}</a></li>
      <li><a href={`${home}#precios`}>{t.nav.pricing}</a></li>
      <li><a href={`${home}#contacto`}>{t.nav.contact}</a></li>
      <li><a href={whatsappUrl(t.contact.whatsapp.message)} rel="noopener" target="_blank">WhatsApp</a></li>
      <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
      <li><a href={CONTACT.github} rel="noopener" target="_blank">GitHub</a></li>
    </ul>
    <p class="footer-rights muted">{t.footer.rights} Fabrizio Turdo</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    padding-block: 2.25rem;
    font-size: 0.9rem;
  }
  .footer-inner {
    display: grid;
    gap: 1.1rem;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .footer-name {
    font-family: var(--display);
    font-size: 1.15rem;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
  }
  .footer-links a {
    color: var(--ink-2);
  }
  .footer-rights {
    font-family: var(--mono);
    font-size: 0.74rem;
  }
  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .footer-rights {
      grid-column: 1 / -1;
    }
  }
</style>
